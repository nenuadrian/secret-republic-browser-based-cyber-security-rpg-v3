# Copy to .env and adjust before `docker compose up`.
APP_PORT=8080
DB_NAME=secretrepublic
DB_USER=secretrepublic
DB_PASS=secretrepublic
DB_ROOT_PASSWORD=change-me-root

# Secret used in cron URLs (/cron/key1/<CRON_KEY>/...). The built-in default is
# public in the source code, so always set your own: `openssl rand -hex 24`
CRON_KEY=

# Optional
APP_TIMEZONE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
